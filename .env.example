# Copy, paste and fill in this template environment variables
NEXT_PUBLIC_BASE_URL=https://www.example.com
NEXT_PUBLIC_ENVIRONMENT=dev

# PostHog (server only: never add the NEXT_PUBLIC_ prefix to these).
# A personal API key of the PostHog project "Realstay", made in PostHog >
# Settings > Personal API keys, with the scopes feature_flag:read,
# feature_flag:write, cohort:read, endpoint:read, query:read and
# error_tracking:read (and endpoint:write and project:read to run
# tools/posthog-endpoints.mjs).
# Put the real value in Vercel and in .env.local only.
POSTHOG_PERSONAL_API_KEY=phx_your_personal_api_key
POSTHOG_HOST=https://eu.posthog.com
POSTHOG_PROJECT_ID=339639
